---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaData from '../components/SchemaData.astro';
import PerformanceMonitor from '../components/PerformanceMonitor.astro';
import SeoChecklist from '../components/SeoChecklist.astro';
import { LOCALES } from '../i18n/ui';
import { remoteImageDimensions } from '../utils/image-dimensions.js';

const {
  title,
  currentLang,
  description = '',
  image = '',
  canonical = Astro.url.href,
  baiduSiteVerification = false,
  alternateUrls = {},
  ogType = 'website',
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags = [],
  robots = 'max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

// 请将此处替换为您主站的 GA4 衡量 ID
const GA_MEASUREMENT_ID = 'G-58B3K5R6KY';

// 国内引擎：content-language 元标签（百度/360 依赖）
const contentLanguageMap: Record<string, string> = {
  'zh-cn': 'zh-CN',
  'zh-tw': 'zh-TW',
  'en': 'en-US',
  'es': 'es-ES', 'ar': 'ar-SA', 'pt': 'pt-BR', 'id': 'id-ID', 'ms': 'ms-MY', 'fr': 'fr-FR',
  'ru': 'ru-RU', 'hi': 'hi-IN', 'ja': 'ja-JP', 'de': 'de-DE', 'ko': 'ko-KR', 'tr': 'tr-TR',
  'vi': 'vi-VN', 'th': 'th-TH', 'it': 'it-IT', 'fa': 'fa-IR', 'nl': 'nl-NL', 'pl': 'pl-PL',
  'sv': 'sv-SE', 'uk': 'uk-UA', 'ro': 'ro-RO',
};
const contentLanguage = contentLanguageMap[currentLang] ?? 'en-US';
const openGraphLocale = contentLanguage.replace('-', '_');

// 国际引擎：hreflang + x-default（Google/Bing），x-default 指向英文
// 强制使用 blog.limaxai.com 作为主要域名，避免 www 和 blog 域名混淆
const baseUrl = 'https://blog.limaxai.com';
const pathname = Astro.url.pathname;
const pathWithoutLang = pathname.replace(/^\/[^/]+/, '') || '/';
// 非根路径统一带尾部斜杠，与站内链接（如 /about/、/tutorials/）一致，避免语言切换跳错
const pathSuffix = pathWithoutLang === '/' ? '/' : (pathWithoutLang.endsWith('/') ? pathWithoutLang : pathWithoutLang + '/');
const canonicalPathname = (() => {
  try {
    return new URL(canonical, baseUrl).pathname;
  } catch {
    return pathname;
  }
})();
const canonicalPathWithoutLang = canonicalPathname.replace(/^\/[^/]+/, '') || '/';
const hreflangPathSuffix = canonicalPathWithoutLang === '/'
  ? '/'
  : (canonicalPathWithoutLang.endsWith('/') ? canonicalPathWithoutLang : canonicalPathWithoutLang + '/');

const hasExplicitAlternates = Object.keys(alternateUrls).length > 0;
const alternateLocales = hasExplicitAlternates
  ? LOCALES.filter((locale) => Boolean(alternateUrls[locale]))
  : LOCALES;

// Articles pass an explicit map so only real translations are declared.
// Shared pages omit the map and use the standard locale-parallel path.
const getHreflangHref = (locale: string) => {
  if (hasExplicitAlternates) {
    return alternateUrls[locale];
  }
  return `${baseUrl}/${locale}${hreflangPathSuffix}`;
};

const metaDescription = description || String(title || 'LimaxAI');

// 简化 canonical URL 生成逻辑
const getCanonicalUrl = () => {
  // 优先使用传入的 canonical 参数
  let urlToUse = canonical;
  
  // 如果没有传入 canonical，使用当前页面 URL
  if (!urlToUse) {
    urlToUse = Astro.url.href;
  }
  
  try {
    // 解析 URL
    const urlObj = new URL(urlToUse, baseUrl);
    
    // 统一域名到 blog.limaxai.com
    urlObj.hostname = 'blog.limaxai.com';
    
    // 确保协议是 https
    urlObj.protocol = 'https:';
    
    // 根据 trailingSlash 配置处理尾部斜杠
    if (!urlObj.pathname.endsWith('/') && !urlObj.search && !urlObj.hash) {
      urlObj.pathname = urlObj.pathname + '/';
    }
    
    return urlObj.href;
  } catch {
    // 如果 URL 解析失败，回退到简单的拼接
    const path = String(canonical || Astro.url.pathname);
    const normalizedPath = path.startsWith('/') ? path : '/' + path;
    const needsTrailingSlash = !normalizedPath.endsWith('/') && !normalizedPath.includes('?') && !normalizedPath.includes('#');
    return `${baseUrl}${normalizedPath}${needsTrailingSlash ? '/' : ''}`;
  }
};

const canonicalUrl = getCanonicalUrl();
const xDefaultHref = hasExplicitAlternates
  ? (alternateUrls.en || alternateUrls[currentLang] || canonicalUrl)
  : getHreflangHref('en');
const absoluteImage = image
  ? (String(image).startsWith('http') ? String(image) : `${baseUrl}${String(image).startsWith('/') ? '' : '/'}${String(image)}`)
  : `${baseUrl}/favicon.svg`;
const openGraphImageDimensions = remoteImageDimensions[absoluteImage] || { width: 1200, height: 630 };
---

<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    
    {/* SEO 验证标签 */}
    {baiduSiteVerification && <meta name="baidu-site-verification" content="codeva-NNhQvugjuQ" />}
    
    {/* 内容语言和生成器 */}
    <meta http-equiv="content-language" content={contentLanguage} />
    <meta name="generator" content={Astro.generator} />
    
    {/* 性能优化 meta 标签 */}
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#3b82f6" />
    <meta name="color-scheme" content="light dark" />

    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="LimaxAI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content={String(openGraphImageDimensions.width)} />
    <meta property="og:image:height" content={String(openGraphImageDimensions.height)} />
    <meta property="og:locale" content={openGraphLocale} />
    {alternateLocales.filter((locale) => locale !== currentLang).map((locale) => (
      <meta property="og:locale:alternate" content={(contentLanguageMap[locale] ?? locale).replace('-', '_')} />
    ))}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
    {ogType === 'article' && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@LimaxAI" />
    <meta name="twitter:creator" content="@LimaxAI" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={title} />

    {/* 国际引擎：hreflang，x-default 指向英文 */}
    {alternateLocales.map((locale) => {
      const href = getHreflangHref(locale);
      // 标准化 hreflang 值（例如 zh-cn 需要保持原样，但需要确保格式正确）
      const hreflangValue = locale.toLowerCase().replace('_', '-');
      return <link rel="alternate" hreflang={hreflangValue} href={href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    {/* ================= 结构化数据 (JSON-LD) 开始 ================= */}
    {/* 网站级 Schema */}
    <SchemaData 
      type="WebSite" 
      currentLang={currentLang}
      data={{
        "name": "LimaxAI Blog",
        "@id": `${baseUrl}/#website`,
        "url": baseUrl,
        "publisher": {
          "@id": "https://www.limaxai.com/#organization"
        },
        "description": "Professional AI generation platform blog with tutorials and news"
      }} 
    />

    {/* 组织级 Schema */}
    <SchemaData 
      type="Organization" 
      currentLang={currentLang}
      data={{
        "name": "LimaxAI",
        "@id": "https://www.limaxai.com/#organization",
        "url": "https://www.limaxai.com",
        "logo": {
          "@type": "ImageObject",
          "url": `${baseUrl}/logo.png`,
          "width": 1000,
          "height": 1000
        }
      }} 
    />
    {/* ================= 结构化数据 (JSON-LD) 结束 ================= */}

    {/* 百度统计（仅简中/繁中加载） */}
    {(currentLang === 'zh-cn' || currentLang === 'zh-tw') && (
      <script is:inline>
        var _hmt = _hmt || [];
        (function() {
          var hm = document.createElement('script');
          hm.src = 'https://hm.baidu.com/hm.js?cd3aae11bcdf5378a37885c4ed4e4d78';
          var s = document.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(hm, s);
        })();
      </script>
    )}

    {/* ================= Google Analytics 4 开始 ================= */}
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', GA_MEASUREMENT_ID);
    </script>
    {/* ================= Google Analytics 4 结束 ================= */}

  </head>
  <body class="flex flex-col min-h-screen bg-gray-50 text-gray-900">

    {/* 导航栏：传入当前语言与路径后缀，以便语言切换时保持同一页面 */}
    <Header currentLang={currentLang} pathSuffix={hreflangPathSuffix} alternateUrls={alternateUrls} />

    {/* 主要内容区域 - slot 会被外部传入的内容替换 */}
    <main class="flex-grow">
      <slot />
    </main>

    {/* 底部栏：传入当前语种以同步多语种文案 */}
    <Footer currentLang={currentLang} />

    {/* 性能监控 */}
    <PerformanceMonitor 
      gaMeasurementId={GA_MEASUREMENT_ID}
      trackCWV={true}
      trackCLS={true}
      trackFID={true}
      trackLCP={true}
      trackINP={true}
      debug={false}
    />

    {/* SEO 检查清单 (开发环境) */}
    <SeoChecklist 
      showInProduction={false}
      currentPage={Astro.url.pathname}
      currentLang={currentLang}
    />

  </body>
</html>
