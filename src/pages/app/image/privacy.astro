---
// src/pages/app/image/privacy.astro
// 图片处理工具（com.limaxai.image）隐私政策 — 中英双语
const APP_NAME_ZH = '图片处理工具';
const APP_NAME_EN = 'Image Processing Tool';
const PACKAGE_NAME = 'com.limaxai.image';
const EFFECTIVE_DATE = '2026年9月4日';
const EFFECTIVE_DATE_EN = 'September 4, 2026';
const CONTACT_EMAIL = 'support@limaxai.com';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>隐私政策 | Privacy Policy - {APP_NAME_ZH} ({PACKAGE_NAME})</title>
    <meta
      name="description"
      content={`${APP_NAME_ZH}（${PACKAGE_NAME}）隐私政策：说明本应用如何收集、使用和保护您的信息。 Privacy Policy for ${APP_NAME_EN} (${PACKAGE_NAME}).`}
    />
    <link rel="canonical" href="https://doc.limaxai.com/app/image/privacy/" />
    <meta name="robots" content="index, follow" />
  </head>
  <body class="bg-white text-gray-800 antialiased">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- 页头 / Header -->
      <header class="border-b border-gray-200 pb-6 mb-10">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">
          {APP_NAME_ZH} 隐私政策
        </h1>
        <p class="text-lg text-gray-500 mb-4">{APP_NAME_EN} Privacy Policy</p>
        <div class="text-sm text-gray-500 space-y-1">
          <p>应用名称 / App Name：{APP_NAME_ZH}（{APP_NAME_EN}）</p>
          <p>包名 / Package Name：{PACKAGE_NAME}</p>
          <p>生效日期 / Effective Date：{EFFECTIVE_DATE} / {EFFECTIVE_DATE_EN}</p>
        </div>
        <nav class="mt-6 flex gap-3">
          <a
            href="#zh"
            class="px-4 py-2 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-700 transition"
          >中文版本</a>
          <a
            href="#en"
            class="px-4 py-2 rounded-lg bg-gray-100 text-gray-800 text-sm font-medium hover:bg-gray-200 transition"
          >English Version</a>
        </nav>
      </header>

      <!-- ===================== 中文版本 ===================== -->
      <main id="zh" class="scroll-mt-6">
        <h2 class="text-2xl font-bold text-gray-900 border-l-4 border-gray-900 pl-3 mb-6">
          中文版隐私协议
        </h2>

        <div class="space-y-8 leading-relaxed text-gray-700">
          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">一、引言</h3>
            <p>
              欢迎使用{APP_NAME_ZH}（以下简称"本应用"）。我们（以下简称"我们"）深知个人信息对您的重要性，我们将按照本隐私协议的规定收集、使用和保护您的个人信息。请您在使用本应用前仔细阅读本协议，一旦您安装或使用本应用，即表示您已阅读并同意本协议的全部内容。
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">二、我们收集的信息</h3>
            <p class="mb-2">本应用主要提供图片压缩、尺寸调整、格式转换等功能。为提供上述功能，我们会收集以下信息：</p>
            <ul class="list-disc pl-6 space-y-1">
              <li>
                <strong>您主动选择的图片文件：</strong>
                仅当您通过系统文件选择器主动选择图片进行编辑时，本应用才会访问该图片的内容。这些图片仅在本应用内进行处理。
              </li>
              <li>
                <strong>设备与系统信息：</strong>
                为保障应用稳定运行和排查故障，我们可能收集设备型号、操作系统版本、应用版本号等基本技术信息。
              </li>
              <li>
                <strong>崩溃与日志信息：</strong>
                当应用发生异常或崩溃时，我们可能收集相应的错误日志，用于改进应用质量。
              </li>
            </ul>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">三、信息的使用</h3>
            <ul class="list-disc pl-6 space-y-1">
              <li>对您选择的图片执行压缩、调整尺寸、转换格式等处理，并将处理结果保存到您指定的位置；</li>
              <li>改进应用功能、优化用户体验、修复错误；</li>
              <li>保障应用安全稳定运行。</li>
            </ul>
            <p class="mt-2">
              我们不会将您的信息用于上述目的之外的任何用途，也不会进行与功能无关的用户画像或个性化广告推荐。
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">四、信息的存储与本地处理</h3>
            <p>
              您选择进行处理的图片<strong>仅在本设备本地完成处理</strong>，我们不会将您的图片上传至我们的服务器，也不会将图片内容用于任何其他目的。处理完成后的文件保存在您设备的本地存储中，您可以随时自行查看、复制或删除。
            </p>
            <p class="mt-2">
              当您卸载本应用后，与本应用相关的数据将随应用一并删除；法律法规另有规定的除外。
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">五、信息的共享与披露</h3>
            <p>我们承诺不会向任何第三方出售您的个人信息。仅在以下情形下，我们可能共享必要的信息：</p>
            <ul class="list-disc pl-6 space-y-1">
              <li>事先获得您的明确同意；</li>
              <li>根据法律法规、司法机关或行政机关的强制性要求；</li>
              <li>为维护我们或公众的合法权益、财产安全所必需。</li>
            </ul>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">六、第三方服务</h3>
            <p>
              本应用可能集成第三方服务（如 Google Play
              应用分发服务、应用统计或崩溃收集服务），这些服务可能按照其各自的隐私政策收集和处理部分设备信息。我们仅允许其在为本应用提供服务的必要范围内使用相关数据。建议您阅读相关第三方的隐私政策以了解详情。
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">七、权限说明</h3>
            <ul class="list-disc pl-6 space-y-1">
              <li>
                <strong>存储 / 照片和视频权限：</strong>
                用于读取您选择的图片，以及将处理后的图片保存到您的设备。该权限仅在您执行相关操作时使用，拒绝授权仅会导致相关功能不可用，不影响应用其他功能。
              </li>
            </ul>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">八、未成年人保护</h3>
            <p>
              本应用主要面向普通用户。我们不会主动收集未成年人的个人信息。如果您是未满
              14 周岁（或您所在司法辖区规定的最低年龄）的未成年人，请在监护人陪同下阅读本协议，并在征得监护人同意后使用本应用。
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">九、您的权利</h3>
            <p>按照适用的法律法规，您享有以下权利：</p>
            <ul class="list-disc pl-6 space-y-1">
              <li>访问、更正和删除您的个人信息；</li>
              <li>撤回授权同意（您可通过系统设置随时关闭相关权限）；</li>
              <li>注销或卸载应用以删除相关数据；</li>
              <li>对我们处理个人信息的行为提出投诉或建议。</li>
            </ul>
            <p class="mt-2">如需行使上述权利，请通过本协议文末的联系方式与我们取得联系。</p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">十、信息存储期限</h3>
            <p>
              我们仅在实现本协议所述目的所必需的期限内保留您的个人信息。超出保存期限后，我们将对个人信息进行删除或匿名化处理。
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">十一、本协议的更新</h3>
            <p>
              我们可能适时对本协议进行修订。修订后的协议将通过本页面发布，重大变更时我们会在应用内以适当方式提示您。建议您定期查阅本页面以了解最新内容。本协议更新后继续使用本应用，即表示您同意修订后的协议。
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">十二、如何联系我们</h3>
            <p>
              如果您对本协议或个人信息保护有任何疑问、意见或建议，请通过以下方式与我们联系。一般情况下，我们将在
              15 个工作日内予以回复。
            </p>
            <p class="mt-2">联系邮箱：<a class="text-blue-600 hover:underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
          </section>
        </div>
      </main>

      <hr class="my-12 border-gray-200" />

      <!-- ===================== English Version ===================== -->
      <main id="en" class="scroll-mt-6">
        <h2 class="text-2xl font-bold text-gray-900 border-l-4 border-gray-900 pl-3 mb-6">
          English Privacy Policy
        </h2>

        <div class="space-y-8 leading-relaxed text-gray-700">
          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">1. Introduction</h3>
            <p>
              Welcome to {APP_NAME_EN} (the "App"). We ("we" or "us") take the protection of your
              personal information seriously. This Privacy Policy explains how we collect, use, and
              safeguard your information when you use the App. Please read this Policy carefully
              before using the App. By installing or using the App, you acknowledge that you have
              read and agree to this Policy.
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">2. Information We Collect</h3>
            <p class="mb-2">
              The App provides image compression, resizing, and format conversion. To deliver these
              features, we may collect the following information:
            </p>
            <ul class="list-disc pl-6 space-y-1">
              <li>
                <strong>Image files you select:</strong>
                The App accesses the content of an image only when you actively select it through
                the system file picker for editing. Such images are processed within the App only.
              </li>
              <li>
                <strong>Device and system information:</strong>
                To keep the App stable and troubleshoot issues, we may collect basic technical
                information such as device model, operating system version, and app version.
              </li>
              <li>
                <strong>Crash and log information:</strong>
                When the App malfunctions or crashes, we may collect the corresponding error logs
                to improve app quality.
              </li>
            </ul>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">3. How We Use Information</h3>
            <ul class="list-disc pl-6 space-y-1">
              <li>To compress, resize, and convert the format of the images you select, and save the results to the location you specify;</li>
              <li>To improve app features, optimize user experience, and fix errors;</li>
              <li>To ensure the secure and stable operation of the App.</li>
            </ul>
            <p class="mt-2">
              We will not use your information for any purpose other than those stated above, and
              we will not build user profiles or deliver personalized advertising unrelated to the
              App's features.
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">4. Data Storage and Local Processing</h3>
            <p>
              The images you choose to process are <strong>processed locally on your device only</strong>.
              We do not upload your images to our servers, and we do not use the content of your
              images for any other purpose. Processed files are saved to your device's local
              storage, where you can view, copy, or delete them at any time.
            </p>
            <p class="mt-2">
              When you uninstall the App, data associated with the App will be removed along with
              it, except where retention is required by applicable laws and regulations.
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">5. Information Sharing and Disclosure</h3>
            <p>We will never sell your personal information to any third party. We may share necessary information only in the following circumstances:</p>
            <ul class="list-disc pl-6 space-y-1">
              <li>With your prior explicit consent;</li>
              <li>To comply with mandatory requirements of laws, regulations, judicial or administrative authorities;</li>
              <li>Where necessary to protect the legitimate rights, property, or safety of us or the public.</li>
            </ul>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">6. Third-Party Services</h3>
            <p>
              The App may integrate third-party services (such as Google Play distribution
              services, analytics, or crash-reporting services). Such services may collect and
              process certain device information in accordance with their own privacy policies. We
              only permit them to use the relevant data to the extent necessary for providing
              services to the App. We recommend that you review the privacy policies of these
              third parties for details.
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">7. Permissions</h3>
            <ul class="list-disc pl-6 space-y-1">
              <li>
                <strong>Storage / Photos and videos permission:</strong>
                Used to read the images you select and to save processed images to your device.
                This permission is used only when you perform the related actions. Denying the
                permission only makes the related features unavailable and does not affect other
                functions of the App.
              </li>
            </ul>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">8. Children's Privacy</h3>
            <p>
              The App is intended for general audiences. We do not knowingly collect personal
              information from children. If you are a minor under the age of 14 (or the minimum age
              required in your jurisdiction), please read this Policy with a parent or guardian and
              use the App only with their consent.
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">9. Your Rights</h3>
            <p>In accordance with applicable laws and regulations, you have the right to:</p>
            <ul class="list-disc pl-6 space-y-1">
              <li>Access, correct, and delete your personal information;</li>
              <li>Withdraw your consent (you may revoke permissions at any time in your system settings);</li>
              <li>Uninstall the App to delete the associated data;</li>
              <li>File complaints or provide feedback regarding our processing of personal information.</li>
            </ul>
            <p class="mt-2">To exercise these rights, please contact us using the information at the end of this Policy.</p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">10. Data Retention</h3>
            <p>
              We retain your personal information only for as long as necessary to fulfill the
              purposes described in this Policy. Once the retention period expires, we will delete
              or anonymize the personal information.
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">11. Changes to This Policy</h3>
            <p>
              We may update this Policy from time to time. Updated versions will be published on
              this page, and for material changes we will notify you through appropriate means
              within the App. We encourage you to review this page periodically. Your continued use
              of the App after an update constitutes acceptance of the revised Policy.
            </p>
          </section>

          <section>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">12. Contact Us</h3>
            <p>
              If you have any questions, comments, or suggestions about this Policy or our
              handling of personal information, please contact us. We generally respond within 15
              business days.
            </p>
            <p class="mt-2">Email: <a class="text-blue-600 hover:underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
          </section>
        </div>
      </main>

      <!-- 页脚 / Footer -->
      <footer class="border-t border-gray-200 mt-12 pt-6 text-sm text-gray-500">
        <p>
          © {new Date().getFullYear()} LimaxAI ·
          <a href="#zh" class="text-blue-600 hover:underline">中文版本</a> ·
          <a href="#en" class="text-blue-600 hover:underline">English Version</a>
        </p>
      </footer>
    </div>
  </body>
</html>
