---
// 博客列表页：/{lang}/blog/
import { getCollection } from 'astro:content';
import BlogIndex from '../../../components/BlogIndex.astro';
import { getAllLocales } from '../../../lib/pages';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  return getAllLocales().map((lang) => {
    const posts = allPosts
      .filter((post) => post.data.lang === lang)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { lang },
      props: { posts, currentLang: lang },
    };
  });
}

const { posts, currentLang } = Astro.props;
const siteBase = (Astro.site?.href ?? 'https://blog.limaxai.com').replace(/\/$/, '');
---

<BlogIndex posts={posts} currentLang={currentLang} canonical={`${siteBase}/${currentLang}/blog/`} />
